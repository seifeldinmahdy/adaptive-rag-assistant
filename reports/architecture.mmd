---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	route_question(route_question)
	retrieve_documents(retrieve_documents)
	grade_documents(grade_documents)
	web_search(web_search)
	generate_answer(generate_answer)
	check_answer(check_answer)
	__end__([<p>__end__</p>]):::last
	__start__ --> route_question;
	check_answer -. &nbsp;verified_or_exhausted&nbsp; .-> __end__;
	check_answer -. &nbsp;retry&nbsp; .-> web_search;
	generate_answer --> check_answer;
	grade_documents -. &nbsp;True&nbsp; .-> generate_answer;
	grade_documents -. &nbsp;False&nbsp; .-> web_search;
	retrieve_documents --> grade_documents;
	route_question -. &nbsp;local&nbsp; .-> retrieve_documents;
	route_question -. &nbsp;web&nbsp; .-> web_search;
	web_search --> generate_answer;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

